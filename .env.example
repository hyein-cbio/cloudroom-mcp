# Optional overrides: no .env file is needed for Personal (no repository).
# Repository selection accepts GitHub owner/repository only: no IDs, URLs or local paths.
# Optional default repository; automatically included in the allowlist.
# CLOUDROOM_GITHUB_REPO=owner/repository
# Additional allowed repositories; Personal is always allowed.
# CLOUDROOM_ALLOWED_GITHUB_REPOS=owner/another-repository,owner/third-repository

# Optional: defaults to ~/.local/bin/room-cli for the current user.
# CLOUDROOM_CLI_PATH=/absolute/path/to/room-cli
# Local control server only; all agents execute on Cloud VMs.
CLOUDROOM_SERVER_URL=http://127.0.0.1:39886

# Repository projects only: omitted by default; ignored for Personal.
# CLOUDROOM_DEFAULT_BASE_BRANCH=main

CLOUDROOM_DEFAULT_PROVIDER=acp-devin
CLOUDROOM_DEFAULT_MODEL=gpt-6-1-sol-high
CLOUDROOM_DEFAULT_REASONING_LEVEL=high

# Total operation deadline, including metadata lookup, registration and CLI calls.
# A deadline never stops the remote agent. No writes are retried automatically.
CLOUDROOM_TIMEOUT_MS=45000

# Share the same directory across Pi/Devin MCP processes for this Cloudroom instance.
# Default: ~/.local/state/cloudroom-mcp/locks
# CLOUDROOM_LOCK_DIR=/absolute/private/path/to/locks
