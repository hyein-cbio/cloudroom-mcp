{
  "name": "cloudroom-mcp",
  "version": "0.1.1",
  "license": "MIT",
  "author": "Hyein Cho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyein-cbio/cloudroom-mcp.git"
  },
  "homepage": "https://github.com/hyein-cbio/cloudroom-mcp#readme",
  "bugs": {
    "url": "https://github.com/hyein-cbio/cloudroom-mcp/issues"
  },
  "keywords": ["mcp", "cloudroom", "room-cli", "coding-agent", "stdio"],
  "bin": {
    "cloudroom-mcp": "server.mjs"
  },
  "files": [
    "server.mjs",
    "src/*.mjs",
    "README.md",
    "README.ko.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example",
    "mcp.example.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "description": "Cloud-only stdio MCP gateway for room-cli",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check server.mjs && node --check src/config.mjs && node --check src/cli.mjs && node --check src/service.mjs && node --check src/schemas.mjs && node --check src/locks.mjs && node --check src/github.mjs && node --check src/projects.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
